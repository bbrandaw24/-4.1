# Copy to .env for local development. Do not commit .env.
MYSQL_DATABASE=smart_agriculture
MYSQL_USER=agri_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=agri_device
MQTT_PASSWORD=change-me-mqtt
MQTT_PORT_HOST=1883
MQTT_WS_PORT_HOST=9001
API_PORT=8000
AI_PORT=8001
MAX_UPLOAD_BYTES=5242880

# Authentication (Day 11): accounts are persisted in the SQLite DB at DB_PATH.
AUTH_SECRET=change-me-auth-secret
AUTH_TOKEN_MAX_AGE=43200
AUTH_SEED_DEMO=1
DB_PATH=/data/users.db
